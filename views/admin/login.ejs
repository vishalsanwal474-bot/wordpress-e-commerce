<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin login · KharidoNow</title>
  <link rel="stylesheet" href="/public/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="admin-login">
  <div class="admin-box">
    <img src="/public/images/logo.png" alt="KharidoNow">
    <h2 style="text-align:center">Admin login</h2>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="post">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Email</label>
      <input class="field" type="email" name="email" value="admin@kharidonow.com" required style="margin:8px 0 12px">
      <label>Password</label>
      <input class="field" type="password" name="password" required style="margin:8px 0 16px">
      <button class="btn" type="submit" style="width:100%">Sign in</button>
    </form>
    <p class="muted" style="text-align:center">admin@kharidonow.com / admin123</p>
    <p style="text-align:center"><a href="/">Back to store</a></p>
  </div>
</body>
</html>
